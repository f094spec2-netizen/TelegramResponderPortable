# Create these at https://my.telegram.org/apps using a dedicated test account.
TG_API_ID=123456
TG_API_HASH=replace-me

# Telethon stores the login session here. Keep it private.
TG_SESSION=.state/telegram-load-test
TG_DEVICE_MODEL=Dedicated Test Endpoint

# All three allowlists are mandatory for `run`.
TG_TEST_ACCOUNT_USERNAME=your_test_account
TG_TEST_ACCOUNT_ID=111111111
TG_TARGET_BOT_USERNAME=sy_agent003_bot
TG_TARGET_BOT_ID=222222222
TG_TARGET_IDS=222222222
TG_ALLOWED_CHAT_IDS=222222222
# Per-ID mode: keyword extracts the requested keyword; fixed sends its text value.
TG_TARGET_RULES_JSON={"222222222":{"mode":"keyword"}}

# The requested random response window.
TG_MIN_DELAY_SECONDS=30
TG_MAX_DELAY_SECONDS=300

# Start safely. Change to false only after `inspect` and dry-run validation.
TG_DRY_RUN=true
TG_MAX_PENDING_REPLIES=100
TG_HEARTBEAT_SECONDS=30
TG_STATUS_FILE=.state/status.json

# Optional: if set, only messages beginning with this prefix are eligible.
# Use [LOADTEST] when the tested bot can tag its test messages.
TG_REQUIRED_PREFIX=
